@page "/login"
@attribute [AllowAnonymous]
@layout MinimalLayout
@inject AuthService AuthApi
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState

<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-brand">JobScout</h1>
        <h2 class="auth-title">Sign in to your account</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error">@errorMessage</div>
        }

        <EditForm Model="model" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" class="form-input" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="model.Password" class="form-input" type="password" placeholder="Enter your password" />
            </div>

            <button type="submit" class="auth-btn" disabled="@isLoading">
                @if (isLoading) { <span class="spinner"></span> }
                Sign In
            </button>
        </EditForm>

        <p class="auth-footer">
            Don't have an account? <a href="/register">Create one</a>
        </p>
    </div>
</div>

@code {
    private LoginRequest model = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthApi.LoginAsync(model);

        if (result is null)
        {
            errorMessage = "Invalid email or password.";
            isLoading = false;
            return;
        }

        await AuthState.MarkUserAsAuthenticated(result.Token);
        Nav.NavigateTo("/", forceLoad: false);
    }
}
