@page "/setup"
@attribute [AllowAnonymous]
@layout MinimalLayout
@inject SetupService SetupApi
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Welcome — JobScout</PageTitle>

<div class="auth-page">
    <div class="auth-card setup-card">
        <h1 class="auth-brand">JobScout</h1>
        <h2 class="auth-title">Welcome — let's get you set up</h2>
        <p class="auth-sub">Three quick steps. Everything below stays on your machine.</p>

        @if (loading)
        {
            <div class="auth-sub">Checking setup status…</div>
        }
        else if (alreadyComplete)
        {
            <div class="auth-error">Setup is already complete. Redirecting to sign-in…</div>
        }
        else
        {
            <div class="setup-stepper">
                <span class="setup-step @(step >= 1 ? "active" : "")">1. Account</span>
                <span class="setup-step @(step >= 2 ? "active" : "")">2. Integrations</span>
                <span class="setup-step @(step >= 3 ? "active" : "")">3. Your first profile</span>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error">@errorMessage</div>
            }

            @if (step == 1)
            {
                <div class="form-group">
                    <label>Display name</label>
                    <input class="form-input" @bind="data.DisplayName" placeholder="Your name" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input class="form-input" type="email" @bind="data.Email" placeholder="you@example.com" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input class="form-input" type="password" @bind="data.Password"
                           placeholder="At least 8 characters, with upper, lower, and a digit" />
                </div>
                <button class="auth-btn" @onclick="GoToStep2">Next</button>
            }
            else if (step == 2)
            {
                <p class="auth-sub">All optional. You can fill these in later from the Settings page.</p>
                <div class="form-group">
                    <label>Anthropic API key <span class="hint">(enables AI scoring)</span></label>
                    <input class="form-input" type="password" @bind="data.AnthropicApiKey" placeholder="sk-ant-…" />
                </div>
                <div class="form-group">
                    <label>SerpAPI key <span class="hint">(LinkedIn / Indeed / Google Jobs)</span></label>
                    <input class="form-input" type="password" @bind="data.SerpApiKey" />
                </div>
                <div class="form-group">
                    <label>Adzuna app id</label>
                    <input class="form-input" @bind="data.AdzunaAppId" />
                </div>
                <div class="form-group">
                    <label>Adzuna app key</label>
                    <input class="form-input" type="password" @bind="data.AdzunaAppKey" />
                </div>
                <div class="setup-actions">
                    <button class="auth-btn ghost" @onclick="() => step = 1">Back</button>
                    <button class="auth-btn" @onclick="() => step = 3">Next</button>
                </div>
            }
            else if (step == 3)
            {
                <p class="auth-sub">Give your search a name. You can edit everything else later.</p>
                <div class="form-group">
                    <label>Profile name</label>
                    <input class="form-input" @bind="data.FirstProfileName" placeholder="e.g. Senior Backend Roles" />
                </div>
                <div class="setup-actions">
                    <button class="auth-btn ghost" @onclick="() => step = 2">Back</button>
                    <button class="auth-btn" @onclick="Finish" disabled="@submitting">
                        @if (submitting) { <span class="spinner"></span> }
                        Finish
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool loading = true;
    private bool alreadyComplete;
    private int step = 1;
    private bool submitting;
    private string? errorMessage;
    private readonly CompleteSetupRequest data = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var needs = await SetupApi.NeedsSetupAsync();
            if (!needs)
            {
                alreadyComplete = true;
                _ = Task.Delay(800).ContinueWith(_ => Nav.NavigateTo("/login"));
            }
        }
        finally { loading = false; }
    }

    private void GoToStep2()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(data.Email) || string.IsNullOrWhiteSpace(data.Password))
        {
            errorMessage = "Email and password are required.";
            return;
        }
        step = 2;
    }

    private async Task Finish()
    {
        errorMessage = null;
        submitting = true;
        try
        {
            var auth = await SetupApi.CompleteAsync(data);
            if (auth is null)
            {
                errorMessage = "Setup failed. Check that the password meets the requirements.";
                return;
            }

            await AuthState.MarkUserAsAuthenticated(auth.Token);
            Nav.NavigateTo("/");
        }
        finally { submitting = false; }
    }
}
