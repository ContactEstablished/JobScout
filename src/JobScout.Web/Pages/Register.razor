@page "/register"
@attribute [AllowAnonymous]
@layout MinimalLayout
@inject AuthService AuthApi
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthState

<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-brand">JobScout</h1>
        <h2 class="auth-title">Create your account</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error">@errorMessage</div>
        }

        <EditForm Model="model" OnValidSubmit="HandleRegister" FormName="RegisterForm">
            <div class="form-group">
                <label for="displayName">Display Name</label>
                <InputText id="displayName" @bind-Value="model.DisplayName" class="form-input" placeholder="Your name" />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" class="form-input" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="model.Password" class="form-input" type="password" placeholder="8+ characters, mixed case, digit" />
            </div>

            <button type="submit" class="auth-btn" disabled="@isLoading">
                @if (isLoading) { <span class="spinner"></span> }
                Create Account
            </button>
        </EditForm>

        <p class="auth-footer">
            Already have an account? <a href="/login">Sign in</a>
        </p>
    </div>
</div>

@code {
    private RegisterRequest model = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthApi.RegisterAsync(model);

        if (result is null)
        {
            errorMessage = "Registration failed. Check your email and password requirements.";
            isLoading = false;
            return;
        }

        await AuthState.MarkUserAsAuthenticated(result.Token);
        Nav.NavigateTo("/", forceLoad: false);
    }
}
