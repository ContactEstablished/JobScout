@inject FilterStateService Filters
@inject FilterPresetsService PresetsApi
@inject ProfileStateService ProfileState
@inject ToastService Toast
@implements IDisposable

<div class="drawer-backdrop @(Filters.IsFilterPanelOpen ? "open" : "")"
     @onclick="Filters.CloseFilterPanel"></div>

<div class="filter-panel @(Filters.IsFilterPanelOpen ? "open" : "")">
    <h2>Filter Jobs</h2>
    <p>Narrow down your job feed with these filters.</p>

    <div class="preset-bar">
        <label>Saved presets</label>
        @if (_presets.Count > 0)
        {
            <div class="preset-list">
                @foreach (var p in _presets)
                {
                    <div class="preset-row">
                        <button class="preset-apply" @onclick="() => ApplyPreset(p)" title="Apply this preset">
                            <i class="ti ti-bookmark"></i> @p.Name
                        </button>
                        <button class="preset-del" @onclick="() => DeletePreset(p)" title="Delete preset">×</button>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="preset-empty">No saved presets for this profile yet.</p>
        }
        <div class="preset-save">
            <input placeholder="Name this filter…" @bind="_newPresetName" maxlength="100" />
            <button class="ghost-button" @onclick="SavePreset"
                    disabled="@string.IsNullOrWhiteSpace(_newPresetName)">
                Save current
            </button>
        </div>
    </div>

    <div class="filter-grid">
        <div class="filter-field">
            <label>Source</label>
            <select @bind="Filters.Source">
                <option value="">All Sources</option>
                <option value="RemoteOK">RemoteOK</option>
                <option value="Adzuna">Adzuna</option>
                <option value="TheMuse">The Muse</option>
                <option value="LinkedIn">LinkedIn</option>
                <option value="Indeed">Indeed</option>
                <option value="Glassdoor">Glassdoor</option>
                <option value="Dice">Dice</option>
                <option value="Wellfound">Wellfound</option>
            </select>
        </div>

        <div class="filter-field">
            <label>Min AI Score</label>
            <select @bind="_minScoreStr">
                <option value="">Any Score</option>
                <option value="7">7+ (Good)</option>
                <option value="8">8+ (Great)</option>
                <option value="9">9+ (Excellent)</option>
            </select>
        </div>

        <div class="filter-field">
            <label>Location Type</label>
            <select @bind="Filters.LocationType">
                <option value="">All</option>
                <option value="Remote">Remote</option>
                <option value="Hybrid">Hybrid</option>
                <option value="OnSite">On-Site</option>
            </select>
        </div>

        <div class="filter-field">
            <label>Job Type</label>
            <select @bind="Filters.JobType">
                <option value="">All</option>
                <option value="FullTime">Full-Time</option>
                <option value="PartTime">Part-Time</option>
                <option value="Contract">Contract</option>
                <option value="Freelance">Freelance</option>
                <option value="Internship">Internship</option>
            </select>
        </div>
    </div>

    <div class="panel-actions">
        <button class="ghost-button" @onclick="Clear">Clear</button>
        <button class="primary-button" @onclick="Apply">Apply Filters</button>
    </div>
</div>

@code {
    private List<FilterPresetDto> _presets = [];
    private string? _newPresetName;

    private string? _minScoreStr
    {
        get => Filters.MinScore?.ToString();
        set => Filters.MinScore = decimal.TryParse(value, out var d) ? d : null;
    }

    protected override async Task OnInitializedAsync()
    {
        Filters.OnPanelToggled += StateHasChanged;
        ProfileState.OnChange += OnProfileChanged;
        await LoadPresetsAsync();
    }

    private async void OnProfileChanged()
    {
        await LoadPresetsAsync();
        StateHasChanged();
    }

    private async Task LoadPresetsAsync()
    {
        if (ProfileState.ActiveProfile is null)
        {
            _presets = [];
            return;
        }
        _presets = await PresetsApi.GetAsync(ProfileState.ActiveProfile.Id);
    }

    private void ApplyPreset(FilterPresetDto preset)
    {
        Filters.CloseFilterPanel();
        Filters.LoadFrom(preset);   // fires OnFiltersChanged → the feed reloads
    }

    private async Task SavePreset()
    {
        if (ProfileState.ActiveProfile is null || string.IsNullOrWhiteSpace(_newPresetName))
            return;

        var saved = await PresetsApi.SaveAsync(
            Filters.ToSaveRequest(ProfileState.ActiveProfile.Id, _newPresetName.Trim()));

        if (saved is not null)
        {
            _newPresetName = null;
            await LoadPresetsAsync();
            Toast.Show("Preset saved.");
        }
        else
        {
            Toast.ShowError("Couldn't save preset — the name may already be in use.");
        }
    }

    private async Task DeletePreset(FilterPresetDto preset)
    {
        if (await PresetsApi.DeleteAsync(preset.Id))
        {
            await LoadPresetsAsync();
            Toast.Show("Preset deleted.");
        }
    }

    private void Apply()
    {
        Filters.CloseFilterPanel();
        Filters.Apply();
    }

    private void Clear()
    {
        Filters.CloseFilterPanel();
        Filters.Clear();
    }

    public void Dispose()
    {
        Filters.OnPanelToggled -= StateHasChanged;
        ProfileState.OnChange -= OnProfileChanged;
    }
}
