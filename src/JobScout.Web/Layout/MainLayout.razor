@inherits LayoutComponentBase
@inject ProfilesService ProfilesApi
@inject ProfileStateService ProfileState

<div class="page-shell">
    <TopBar />
    <Sidebar />
    <main class="main-content">
        @Body
    </main>
    <InsightsPanel />
</div>
<FilterPanel />
<ToastHost />

@code {
    protected override async Task OnInitializedAsync()
    {
        var profiles = await ProfilesApi.GetAllAsync();
        ProfileState.SetProfiles(profiles);
    }
}
